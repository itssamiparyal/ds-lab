/* C Program to Calculate b^n mod m Using Repeated Squaring */

#include <stdio.h>

int power(int b, int n, int m)
{
    int res = 1;

    b = b % m;

    while (n > 0)
    {
        if (n % 2 == 1)
            res = (res * b) % m;

        n = n >> 1;
        b = (b * b) % m;
    }

    return res;
}

int main()
{
    int b, n, m, result;

    printf("\nEnter the positive integer b: ");
    scanf("%d", &b);

    printf("\nEnter the positive integer n: ");
    scanf("%d", &n);

    printf("\nEnter the positive integer m: ");
    scanf("%d", &m);

    result = power(b, n, m);

    printf("\nModulo Power is: %d\n", result);

    return 0;
}